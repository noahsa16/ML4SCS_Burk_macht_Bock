# Python
__pycache__/
*.py[cod]
*.pyo
*.pyd
*.so

# Virtual environments
.venv/
venv/
env/

# Jupyter
.ipynb_checkpoints/

# Mac / OS
.DS_Store
**/.DS_Store

# Build artifacts
build/

# Data / outputs — regenerierbar (python -m src.merge, plot_alignment.py …)
data/processed/
data/raw/
# Why: Fremd-Probandendaten des Schweizer Kooperationspartners — menschliche
# IMU-/Pen-Rohdaten, dieselbe Schutzklasse wie die eigenen Sessions. Lagen am
# 2026-08-08 versehentlich in einem Commit (bereits gestaged, beim Committen
# einer unbeteiligten Änderung mitgeschrieben) und mussten per git filter-repo
# aus der History beider Remotes entfernt werden.
data/foreign_data/
# Why: der Adapter-CODE ist versioniert, seine Ausgabe nicht — output/ trägt die
# konvertierten Fremd-Probandendaten (1,4 GB) und entsteht aus foreign_adapter/
# plus data/foreign_data/ jederzeit neu.
foreign_adapter/output/
# Why: Team-IMU-Aufnahmen aus der Frühphase, von keinem Modul referenziert.
data/_archive/
# Why: gepacktes Daten-Bundle (menschliche Probanden-IMU-Daten) für den CI-Sweep —
# lokal gepackt, out-of-repo gehostet. Darf NIE in dieses PUBLIC-Repo gelangen.
# Glob statt Literal: die pool-spezifischen Bundles (sweep_data_50hz.zip,
# sweep_data_100hz_grav.zip) sind dieselben Probandendaten unter anderem Namen.
sweep_data*.zip
# Why: die Joblibs sind zu groß (MB) und regenerierbar, daher models/-Inhalte
# ignored. hmm_live.json ist dagegen ein winziges, deploybares Live-Artefakt
# (2x2-Matrix + Prior), das die Inferenz zur Laufzeit braucht -> per Negation
# mitversioniert. models/* (statt models/) lässt das Re-Include zu — ein
# komplett ausgeschlossenes Verzeichnis kann git nicht re-includen.
models/*
!models/hmm_live.json
results/plots/*.png
results/plots/*.jpg
results/metrics/*.csv

# IDE- und Tooling-State — regeneriert sich beim Öffnen, erzeugt nur Diff-Rauschen
.idea/
.ai/

# Misc
.env

# Stray pen logs (manual pen_logger.py runs without --session)
pen_log_*.csv

# Stray markdown reports written outside reports/
data/session_*_report*.md
data/raw/**/session_*_report*.md

# Local model progression timeline (working doc, not for the repo)
reports/model_progression.md

# Server logs
logs/


# Visual Companion brainstorming session artefacts
.superpowers/
docs/superpowers/

# Study Mode markers (regenerated per-session by the server)
data/raw/markers/

# Session index — owned by the running server, derivable from data/raw/.
# Previously tracked, which led to git operations overwriting working-tree
# rows (e.g. uncommitted session_stop appends getting wiped on a checkout).
data/sessions.csv

# Focus-Tracker live-inference log — append-only at 1 Hz while server runs,
# grows ~3 MB/day. Local artefact, not part of the repo.
data/inference_log.csv
data/passive_decisions.csv

# Local pipeline overview — personal cheat sheet, not part of repo docs.
ML_PIPELINE_OVERVIEW.md

# Internal idea backlog — brainstorming, not part of repo docs.
projektideen.md

# Forecast / Lernkurven-Prognose — Research-Tooling + Artefakte,
# nicht Teil der operativen Pipeline.
forecast/

# Xcode per-user IDE state (window layout, cursor positions, breakpoints).
# Regenerates on every open and creates noisy diffs.
**/xcuserdata/
*.xcuserstate

# Pasted macOS screenshots (verification artifacts, not repo docs).
Bildschirmfoto*.png
Screenshot*.png

# Probandendaten-Bundle (Drive-Download, Quelle fuer die Datenpublikation).
# Niemals committen - origin ist PUBLIC. Ohne abschliessenden Slash, damit
# auch der lokale iCloud-Symlink ignoriert wird.
/alldata

# Lokaler Marker eines bereits vom Pod geholten Artefakts.
/.pod_fetched

# Arbeitsnotizen zum Data-in-Brief-Manuskript (Stichpunkte, Zahlen, offene
# Fragen). Working docs, kein Repo-Inhalt — das Manuskript lebt in Overleaf.
paper_notes/

# Isoliertes venv fuer die Core-ML-Konvertierung (siehe requirements-coreml.txt)
.venv-coreml/
