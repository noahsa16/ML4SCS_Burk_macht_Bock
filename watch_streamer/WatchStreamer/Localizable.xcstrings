            "state" : "translated",
            "value" : "End"
          }
        }
      }
    },
    "Der Uhr fehlt die Workout-Freigabe. Erteile sie in den Health-Einstellungen." : {
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "The watch is missing the workout permission. Grant it in the Health settings."
          }
        }
      }
    },
    "Die Uhr hat den Stopp nicht bestätigt." : {
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "The watch did not confirm the stop."
          }
        }
      }
    },
    "Die Uhr hat die Messung beendet, weil die Workout-Sitzung nicht läuft. Prüfe die Workout-Freigabe in den Health-Einstellungen." : {
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "The watch stopped measuring because the workout session is not running. Check the workout permission in the Health settings."
          }
        }
      }
    },
    "Die Uhr hat nicht geantwortet. Prüfe, ob sie in Reichweite ist." : {
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "The watch did not answer. Check that it is in range."
          }
        }
      }
    },
    "Die Uhr misst, das iPhone zeichnet mit. Deine Schreibzeit zählt weiterhin der Tagestracker." : {
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "The watch measures, the iPhone draws along. Your writing time is still counted by the daily tracker."
          }
        }
      }
    },
    "Die Uhr misst, die Seite füllt sich." : {
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "The watch measures, the page fills."
